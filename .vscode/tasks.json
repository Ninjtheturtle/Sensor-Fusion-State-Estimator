{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: Configure (Debug)",
      "type": "shell",
      "command": "C:/msys64/ucrt64/bin/cmake.exe",
      "args": ["--preset", "ucrt64-debug"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "C:\\msys64\\ucrt64\\bin;${env:PATH}"
        }
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": "$gcc"
    },
    {
      "label": "CMake: Build (Debug)",
      "type": "shell",
      "command": "C:/msys64/ucrt64/bin/cmake.exe",
      "args": ["--build", "build/debug"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "C:\\msys64\\ucrt64\\bin;${env:PATH}"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": "$gcc",
      "dependsOn": "CMake: Configure (Debug)"
    },
    {
      "label": "CMake: Build (Release)",
      "type": "shell",
      "command": "C:/msys64/ucrt64/bin/cmake.exe",
      "args": ["--build", "build/release"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "C:\\msys64\\ucrt64\\bin;${env:PATH}"
        }
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": "$gcc"
    },
    {
      "label": "CTest: Run All Tests",
      "type": "shell",
      "command": "C:/msys64/ucrt64/bin/ctest.exe",
      "args": ["--preset", "test-debug", "--verbose"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "C:\\msys64\\ucrt64\\bin;${env:PATH}"
        }
      },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
